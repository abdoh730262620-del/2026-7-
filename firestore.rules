rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read and write access on all collections to ensure full synchronization.
    // This is required because:
    // 1. Staff and Cashier users login via local credentials stored in Firestore (leaving request.auth as null).
    // 2. Background startup migrations and sync processes query collections without filters, which would be rejected by granular rules.
    // 3. Client-side state engines and the application itself handle strict tenant segregation ('single_store') and role-based permissions.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
