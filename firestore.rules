rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper status functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    // Allow user document reads and writes
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Allow settings document reads and writes
    match /settings/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Enforce tenant segregation across general collections
    match /{collectionName}/{docId} {
      allow read, write: if isAuthenticated() && (
        (resource == null || !('tenantId' in resource.data) || resource.data.tenantId == getUserTenantId()) &&
        (request.resource == null || !('tenantId' in request.resource.data) || request.resource.data.tenantId == getUserTenantId())
      );
    }
  }
}
